# AgriPilot AI - Environment Configuration Example

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL / Prisma)
# For local Docker: postgresql://agripilot:agripilot123@localhost:5432/agripilot_db?schema=public
DATABASE_URL="postgresql://agripilot:agripilot123@localhost:5432/agripilot_db?schema=public"

# Redis Configuration (BullMQ async queue)
REDIS_URL="redis://localhost:6379"

# Security & JWT Authentication
JWT_SECRET="agripilot-super-secure-production-jwt-secret-key-32chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false

# Weather Provider Configuration
# Supported: 'open-meteo' (no key required), 'tomorrow_io', 'openweathermap', 'mock'
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""
WEATHER_CACHE_TTL_MINUTES=60

# AI Provider Configuration (Provider-agnostic interface)
# Supported: 'gemini', 'openai', 'anthropic', 'mock'
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Vision Diagnostics Model
VISION_PROVIDER="mock"
VISION_CONFIDENCE_THRESHOLD=0.65

# Storage / Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Demonstration & Simulation Mode
ENABLE_DEMO_SEED=true
SIMULATE_SENSOR_STREAM=false
